@page
@model IndexModel
@using Microsoft.Extensions.Options
@using MMDb.Options
@inject IOptions<TMDbOptions> TMDbOptions
@{
    ViewData["Title"] = "Films";
}

<div class="row g-3 mb-3 d-none d-md-flex">
    <div class="col-md-6">
        <partial name="_RatingChart" model='("My Ratings", Model.MyRatingCounts)' />
    </div>
    <div class="col-md-6">
        <partial name="_RatingChart" model='("Community Ratings", Model.CommunityRatingCounts)' />
    </div>
</div>

<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <form id="film-search" class="input-group flex-grow-1 w-auto">
        <input type="search" id="film-search-input" class="form-control" placeholder="Search Titles" aria-label="Search Titles" />
        <a id="film-lookup" asp-page="/Films/Search" class="btn btn-secondary d-flex align-items-center" title="Search TMDb" aria-label="Search TMDb">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" /></svg>
        </a>
    </form>
    <div id="film-paging"></div>
</div>

<table id="films" class="table table-hover align-middle w-100 fs-5 film-table">
    <thead>
        <tr>
            <th></th>
            <th>Title</th>
            <th>Year</th>
            <th class="d-none d-md-table-cell text-nowrap">Director</th>
            <th class="text-center" title="My Rating">MR</th>
            <th class="text-center" title="Community Rating">CR</th>
            <th class="d-none d-md-table-cell text-center" title="My Rating minus Community Rating">&Delta;</th>
            <th class="d-none d-sm-table-cell text-nowrap">Watched</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Film film in Model.Films)
        {
            <tr data-href="@Url.Page("/Films/Details", new { id = film.FilmId })">
                <td class="p-1">
                    @if (film.PosterPath is not null)
                    {
                        <img src="@(TMDbOptions.Value.ImageBaseUrl)w92@(film.PosterPath)" alt="" class="rounded" width="43" height="64" loading="lazy" />
                    }
                </td>
                <td class="text-truncate" style="max-width: 0; width: 100%" title="@film.Title">@film.Title</td>
                <td>@film.Year</td>
                <td class="d-none d-md-table-cell text-nowrap">@film.Director</td>
                <td class="text-center" data-order="@film.Rating"><span class="badge fs-5 text-black" style="@RatingColour.StyleForRating(film.Rating)">@film.Rating</span></td>
                <td class="text-center" data-order="@(film.CommunityRating ?? -1)">
                    @if (film.CommunityRating is double communityRating)
                    {
                        <span class="badge fs-5 text-black" style="@RatingColour.StyleForRating(communityRating)">@communityRating.ToString("0.0")</span>
                    }
                </td>
                <td class="d-none d-md-table-cell text-center text-nowrap" data-order="@(film.RatingDelta ?? -99)">@film.RatingDelta?.ToString("+0.0;-0.0;0.0")</td>
                <td class="d-none d-sm-table-cell text-nowrap" data-order="@(film.WatchedOn?.ToString("yyyy-MM-dd") ?? "0000-00-00")">@film.WatchedOn?.ToString("d MMM yyyy")</td>
            </tr>
        }
    </tbody>
</table>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.css" />
    <style>
        #film-paging ul.pagination { margin: 0; }
        #films tbody tr[data-href] { cursor: pointer; }
    </style>
}

@section Scripts {
    <script src="~/lib/datatables.net/dataTables.min.js"></script>
    <script src="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.js"></script>
    <script>
        const films = new DataTable('#films', {
            order: [[7, 'desc']],
            autoWidth: false,
            pageLength: 100,
            columnDefs: [{ targets: 0, orderable: false }],
            language: { emptyTable: 'No films yet.', zeroRecords: 'No matching films.', info: '_START_ to _END_ of _TOTAL_', infoEmpty: '0 to 0 of 0', infoFiltered: '(_MAX_)' },
            layout: { topStart: null, topEnd: null, bottomStart: 'info', bottomEnd: 'paging' }
        });
        document.getElementById('film-paging').append(document.querySelector('#films_wrapper .dt-paging'));
        document.querySelector('#films tbody').addEventListener('click', event => {
            const row = event.target.closest('tr[data-href]');
            if (!row) {
                return;
            }
            if (event.ctrlKey || event.metaKey) {
                window.open(row.dataset.href, '_blank');
            }
            else {
                window.location.href = row.dataset.href;
            }
        });
        const searchInput = document.getElementById('film-search-input');
        // The search button looks the current search up on TMDb.
        document.getElementById('film-lookup').addEventListener('click', event => {
            event.currentTarget.href = `${event.currentTarget.pathname}?query=${encodeURIComponent(searchInput.value.trim())}`;
        });
        searchInput.addEventListener('input', () => films.search(searchInput.value).draw());
        // Re-apply a search the browser restores when navigating back.
        window.addEventListener('pageshow', () => films.search(searchInput.value).draw());
        // Pressing Enter looks the search up on TMDb, like the search button.
        document.getElementById('film-search').addEventListener('submit', event => {
            event.preventDefault();
            const lookup = document.getElementById('film-lookup');
            window.location.href = `${lookup.pathname}?query=${encodeURIComponent(searchInput.value.trim())}`;
        });
    </script>
}