@model (string Title, int[] Counts)
@{
    int max = Math.Max(1, Model.Counts.Max());
}

<div class="card h-100">
    <div class="card-body">
        <h2 class="h6 card-title">@Model.Title</h2>
        <div class="d-flex align-items-end" style="height: 120px; gap: 2px" role="img" aria-label="@Model.Title by rating">
            @for (int index = 0; index < Model.Counts.Length; index++)
            {
                int rating = index + 1;
                int count = Model.Counts[index];
                string height = (count * 100.0 / max).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                string barStyle = $"height: {height}%; border-radius: 4px 4px 0 0; {RatingColour.StyleForRating(rating)}";
                <div class="flex-fill h-100 d-flex flex-column justify-content-end" style="flex-basis: 0" title="@rating: @count @(count == 1 ? "film" : "films")">
                    <div style="@barStyle"></div>
                </div>
            }
        </div>
        <div class="d-flex border-top pt-1" style="gap: 2px">
            @for (int rating = 1; rating <= Model.Counts.Length; rating++)
            {
                <div class="flex-fill text-center small text-muted" style="flex-basis: 0">@rating</div>
            }
        </div>
    </div>
</div>