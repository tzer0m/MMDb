@model Film
@using Microsoft.Extensions.Options
@using MMDb.Options
@inject IOptions<TMDbOptions> TMDbOptions
@inject IOptions<ExternalLinkOptions> ExternalLinks
@{
    bool isRated = Model.FilmId != 0;
    string encodedTitle = Uri.EscapeDataString(Model.Title);
    string? tmdbUrl = Model.TMDbId is int tmdbId ? string.Format(ExternalLinks.Value.TMDb, tmdbId) : null;
    string? imdbUrl = Model.IMDbId is string imdbId ? string.Format(ExternalLinks.Value.IMDb, imdbId) : null;
    string rottenTomatoesUrl = string.Format(ExternalLinks.Value.RottenTomatoes, encodedTitle);
    string metacriticUrl = string.Format(ExternalLinks.Value.Metacritic, encodedTitle);
    string swagBaggerUrl = string.Format(ExternalLinks.Value.SwagBagger, Uri.EscapeDataString(SearchText.Simplify(Model.Year is int searchYear ? $"{Model.Title} {searchYear}" : Model.Title)), Uri.EscapeDataString(Model.Title), Model.Year?.ToString() ?? string.Empty);
}

<div class="detail-layout">
    <div class="detail-poster">
        <div class="ratio rounded overflow-hidden bg-body-secondary" style="--bs-aspect-ratio: 150%">
            @if (Model.PosterPath is not null)
            {
                <img src="@(TMDbOptions.Value.ImageBaseUrl)w342@(Model.PosterPath)" alt="@Model.Title poster" class="object-fit-cover" />
            }
        </div>
    </div>
    <div class="detail-header d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="mb-1">
                @Model.Title
                @if (Model.Year is int year)
                {
                    <span class="text-muted fw-normal">(@year)</span>
                }
            </h1>
            <p class="text-muted mb-0">
                @Model.RuntimeText
                @if (Model.RuntimeText is not null && Model.WatchedOn is not null)
                {
                    <text>&middot;</text>
                }
                @Model.WatchedOn?.ToString("d MMMM yyyy")
            </p>
        </div>
        <div class="d-flex align-items-stretch gap-2">
            @if (isRated)
            {
                <span class="badge fs-2 rating-lg text-black" style="@RatingColour.StyleForRating(Model.Rating)" title="My Rating">@Model.Rating</span>
            }
            else
            {
                <span class="badge fs-2 rating-lg border border-secondary" style="min-width: 2.5em" title="My Rating"></span>
            }
            @if (Model.CommunityRating is double communityRating)
            {
                <span class="badge fs-2 rating-lg text-black" style="@RatingColour.StyleForRating(communityRating)" title="Community Rating">@communityRating.ToString("0.0")</span>
            }
            else
            {
                <span class="badge fs-2 rating-lg border border-secondary" style="min-width: 2.5em" title="Community Rating"></span>
            }
            @if (isRated && User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Films/Edit" asp-route-id="@Model.FilmId" class="btn btn-outline-secondary fs-2 rating-lg d-flex align-items-center px-3 py-0" title="Edit" aria-label="Edit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325" /></svg>
                </a>
            }
        </div>
    </div>
    <div class="detail-body">
        @if (!string.IsNullOrWhiteSpace(Model.Overview))
        {
            <p style="white-space: pre-line">@Model.Overview</p>
        }

        <div class="d-flex flex-wrap gap-3 mt-3">
            @if (ViewData["ShowSwagBagger"] is true)
            {
                <a href="@swagBaggerUrl" target="_blank" rel="noopener" class="btn btn-outline-secondary d-flex align-items-center gap-2" title="Search SwagBagger">
                    <img src="/img/swagbagger.svg" alt="SwagBagger" height="20" />
                    <span class="text-body fw-bold">Search</span>
                </a>
            }
            @{ ExternalRating("IMDb", "imdb", imdbUrl, Model.IMDbRating?.ToString("0.0"), Model.IMDbRating, 0, 10); }
            @{ ExternalRating("TMDb", "tmdb", tmdbUrl, Model.TMDbRating?.ToString("0.0"), Model.TMDbRating, 0, 10); }
            @{ ExternalRating("Rotten Tomatoes", "rottentomatoes", rottenTomatoesUrl, Model.RottenTomatoes is int rottenTomatoes ? $"{rottenTomatoes}%" : null, Model.RottenTomatoes, 0, 100); }
            @{ ExternalRating("Metacritic", "metacritic", metacriticUrl, Model.Metacritic?.ToString(), Model.Metacritic, 0, 100); }
        </div>
    </div>
</div>

@{
    void ExternalRating(string name, string icon, string? url, string? text, double? value, double min, double max)
    {
        <a href="@url" target="_blank" rel="noopener" class="btn btn-outline-secondary d-flex align-items-center gap-2 @(url is null ? "disabled" : "")" title="@name">
            <img src="/img/@(icon).svg" alt="@name" height="20" />
            @if (value is double rating)
            {
                <span class="badge fs-6 text-black" style="@RatingColour.StyleForRating(rating, min, max)">@text</span>
            }
        </a>
    }
}
