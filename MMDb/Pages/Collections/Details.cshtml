@page "/collection/{id}"
@model MMDb.Pages.Collections.DetailsModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex flex-wrap flex-md-nowrap justify-content-between align-items-start gap-3 mb-4">
    <div class="min-w-0">
        <h1 class="mb-1">@Model.Name</h1>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <p class="text-muted mb-0">@Model.Films.Count Films &middot; @Model.Films.Count(x => x.FilmId != 0) Seen</p>
        }
        else
        {
            <p class="text-muted mb-0">@Model.Films.Count Seen</p>
        }
    </div>
    <div class="d-flex align-items-stretch gap-2 flex-shrink-0">
        @if (Model.AverageMyRating is double averageMyRating)
        {
            <span class="badge fs-2 rating-lg text-black" style="@RatingColour.StyleForRating(averageMyRating)" title="Average My Rating">@averageMyRating.ToString("0.0")</span>
        }
        else
        {
            <span class="badge fs-2 rating-lg border border-secondary" style="min-width: 2.5em" title="Average My Rating"></span>
        }
        @if (Model.AverageCommunityRating is double averageCommunityRating)
        {
            <span class="badge fs-2 rating-lg text-black" style="@RatingColour.StyleForRating(averageCommunityRating)" title="Average Community Rating">@averageCommunityRating.ToString("0.0")</span>
        }
        else
        {
            <span class="badge fs-2 rating-lg border border-secondary" style="min-width: 2.5em" title="Average Community Rating"></span>
        }
        @if (Model.AverageRatingDelta is double averageDelta)
        {
            <span class="badge fs-2 rating-lg border border-secondary text-body d-flex align-items-center" title="Average My Rating minus Community Rating">@averageDelta.ToString("+0.0;-0.0;0.0")</span>
        }
    </div>
</div>

<table id="collection-films" class="table table-hover align-middle w-100 fs-5 film-table">
    <thead>
        <tr>
            <th class="d-none d-md-table-cell"></th>
            <th class="d-none d-md-table-cell">Title</th>
            <th class="d-none d-md-table-cell">Year</th>
            <th class="d-none d-md-table-cell text-nowrap">Director</th>
            <th class="d-none d-md-table-cell text-center" title="My Rating">MR</th>
            <th class="d-none d-md-table-cell text-center" title="Community Rating">CR</th>
            <th class="d-none d-md-table-cell text-center" title="My Rating minus Community Rating">&Delta;</th>
            <th class="d-none d-md-table-cell text-nowrap">Watched</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Film film in Model.Films)
        {
            bool isRated = film.FilmId != 0;
            string? href = isRated ? Url.Page("/Films/Details", new { id = film.FilmId }) : film.TMDbId is int tmdbId ? Url.Page("/Films/Preview", new { tmdbId }) : null;
            <tr class="position-relative">
                <td class="p-1">
                    @if (await Posters.UrlAsync(film.TMDbId, film.IMDbId, film.PosterPath, 92) is string posterUrl)
                    {
                        <img src="@posterUrl" alt="" class="rounded" width="43" height="64" loading="lazy" />
                    }
                </td>
                <td style="max-width: 0; width: 100%" data-order="@film.Title">
                    <div class="text-truncate" title="@film.Title">
                        @if (href is not null)
                        {
                            <a href="@href" class="stretched-link text-reset text-decoration-none">@film.Title</a>
                        }
                        else
                        {
                            @film.Title
                        }
                    </div>
                    <div class="d-flex d-md-none align-items-center gap-2 mt-1">
                        <span class="text-truncate text-muted small">@(film.Year is int year ? $"{year} · " : "")@film.Director</span>
                        @{ MyRating(film, isRated, "ms-auto"); }
                        @if (film.CommunityRating is double mobileCommunityRating)
                        {
                            <span class="badge text-black" style="@RatingColour.StyleForRating(mobileCommunityRating)" title="Community Rating">@mobileCommunityRating.ToString("0.0")</span>
                        }
                    </div>
                </td>
                <td class="d-none d-md-table-cell" data-order="@(film.Year ?? 9999)">@film.Year</td>
                <td class="d-none d-md-table-cell text-nowrap">@film.Director</td>
                <td class="d-none d-md-table-cell text-center" data-order="@(isRated ? film.Rating : 0)">@{ MyRating(film, isRated, "fs-5"); }</td>
                <td class="d-none d-md-table-cell text-center" data-order="@(film.CommunityRating ?? -1)">
                    @if (film.CommunityRating is double communityRating)
                    {
                        <span class="badge fs-5 text-black" style="@RatingColour.StyleForRating(communityRating)">@communityRating.ToString("0.0")</span>
                    }
                </td>
                <td class="d-none d-md-table-cell text-center text-nowrap" data-order="@(isRated ? film.RatingDelta ?? -99 : -99)">@(isRated ? film.RatingDelta?.ToString("+0.0;-0.0;0.0") : "")</td>
                <td class="d-none d-md-table-cell text-nowrap" data-order="@(film.WatchedOn?.ToString("yyyy-MM-dd") ?? "0000-00-00")">@film.WatchedOn?.ToString("d MMM yyyy")</td>
            </tr>
        }
    </tbody>
</table>

@{
    void MyRating(Film film, bool isRated, string extraClass)
    {
        if (isRated)
        {
            <span class="badge text-black @extraClass" style="@RatingColour.StyleForRating(film.Rating)" title="My Rating">@film.Rating</span>
        }
        else
        {
            <span class="badge bg-secondary text-body @extraClass" title="Not Rated Yet">#</span>
        }
    }
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="~/lib/datatables.net/dataTables.min.js"></script>
    <script src="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.js"></script>
    <script>
        // Sortable by any column except the poster, oldest first by default; no paging, search or info since collections are short.
        new DataTable('#collection-films', {
            order: [[2, 'asc'], [1, 'asc']],
            autoWidth: false,
            paging: false,
            searching: false,
            info: false,
            columnDefs: [{ targets: 0, orderable: false }],
            layout: { topStart: null, topEnd: null, bottomStart: null, bottomEnd: null }
        });
    </script>
}
