@page "/film/{id:int}"
@model MMDb.Pages.Films.DetailsModel
@{
    ViewData["Title"] = Model.Film.Title;
}

@if (TempData["Message"] is string message)
{
    <div class="alert alert-secondary">@message</div>
}

<partial name="_FilmHeader" model="Model.Film" />
<partial name="_FilmPeople" model="Model.People" />
