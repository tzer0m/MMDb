@page "/film/{id:int}"
@model MMDb.Pages.Films.DetailsModel
@using Microsoft.Extensions.Options
@using MMDb.Options
@inject IOptions<TMDbOptions> TMDbOptions
@{
    ViewData["Title"] = Model.Film.Title;
}

@if (TempData["Message"] is string message)
{
    <div class="alert alert-secondary">@message</div>
}

<div class="row g-3">
    <div class="col-12 col-md-2">
        <div class="ratio rounded overflow-hidden bg-body-secondary" style="--bs-aspect-ratio: 150%">
            @if (Model.Film.PosterPath is not null)
            {
                <img src="@(TMDbOptions.Value.ImageBaseUrl)w342@(Model.Film.PosterPath)" alt="@Model.Film.Title poster" class="object-fit-cover" />
            }
        </div>
    </div>
    <div class="col-12 col-md-10">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <h1 class="mb-1">
                    @Model.Film.Title
                    @if (Model.Film.Year is int year)
                    {
                        <span class="text-muted fw-normal">(@year)</span>
                    }
                </h1>
                <p class="text-muted mb-0">
                    @Model.Film.RuntimeText
                    @if (Model.Film.RuntimeText is not null && Model.Film.WatchedOn is not null)
                    {
                        <text>&middot;</text>
                    }
                    @Model.Film.WatchedOn?.ToString("d MMMM yyyy")
                </p>
            </div>
            <div class="d-flex align-items-stretch gap-2">
                <span class="badge fs-2 text-black" style="@RatingColour.StyleForRating(Model.Film.Rating)">@Model.Film.Rating</span>
                <a asp-page="/Films/Edit" asp-route-id="@Model.Film.FilmId" class="btn btn-outline-secondary fs-2 d-flex align-items-center px-3 py-0" title="Edit" aria-label="Edit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325" /></svg>
                </a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Film.Overview))
        {
            <p style="white-space: pre-line">@Model.Film.Overview</p>
        }
    </div>
</div>

@if (Model.Director is not null || Model.Cast.Count > 0)
{
    <div class="row g-3 mt-4">
        @if (Model.Director is not null)
        {
            <div class="col-12 col-md-2">
                <h2 class="h5">Director</h2>
                @{ await PersonColumn(Model.Director); }
            </div>
        }
        @if (Model.Cast.Count > 0)
        {
            <div class="col-12 col-md-10">
                <h2 class="h5">Cast</h2>
                <div class="row row-cols-2 row-cols-md-5 g-3">
                    @foreach (Person person in Model.Cast)
                    {
                        <div class="col">
                            @{ await PersonColumn(person); }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@{
    async Task PersonColumn(Person person)
    {
        <div class="ratio rounded overflow-hidden bg-body-secondary mb-2" style="--bs-aspect-ratio: 150%">
            @if (person.ProfilePath is not null)
            {
                <img src="@(TMDbOptions.Value.ImageBaseUrl)w185@(person.ProfilePath)" alt="@person.Name" class="object-fit-cover" loading="lazy" />
            }
        </div>
        <div class="fw-semibold mb-2">@person.Name</div>
        <div class="list-group list-group-flush small">
            @foreach (Film film in Model.OtherFilms[person.PersonId])
            {
                <a asp-page="/Films/Details" asp-route-id="@film.FilmId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2 px-0">
                    <span class="text-truncate" title="@film.Title">@film.Title</span>
                    <span class="badge text-black" style="@RatingColour.StyleForRating(film.Rating)">@film.Rating</span>
                </a>
            }
        </div>
    }
}
