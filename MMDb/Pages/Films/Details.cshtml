@page "/film/{id:int}"
@model MMDb.Pages.Films.DetailsModel
@{
    ViewData["Title"] = Model.Film.Title;
}

<p><a asp-page="/Index">&larr; All films</a></p>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="mb-1">
            @Model.Film.Title
            @if (Model.Film.Year is int year)
            {
                <span class="text-muted fw-normal">(@year)</span>
            }
        </h1>
        <p class="text-muted mb-0">
            @if (Model.Film.RuntimeText is string runtime)
            {
                <span>@runtime</span>
            }
            @if (Model.Film.RuntimeText is not null && Model.Film.Director is not null)
            {
                <span>&middot;</span>
            }
            @if (Model.Film.Director is string director)
            {
                <span>Directed by @director</span>
            }
        </p>
    </div>
    <div class="text-end">
        <span class="badge text-bg-warning fs-2">@Model.Film.Rating<small class="fs-6">/10</small></span>
        @if (Model.Film.WatchedOn is DateOnly watched)
        {
            <div class="text-muted small mt-1">Watched @watched.ToString("d MMMM yyyy")</div>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Film.Overview))
{
    <h2 class="h5">Overview</h2>
    <p style="white-space: pre-line">@Model.Film.Overview</p>
}

<a asp-page="/Films/Edit" asp-route-id="@Model.Film.FilmId" class="btn btn-outline-secondary">Edit</a>
