@page "/film/{id:int}/edit"
@model MMDb.Pages.Films.EditModel
@{
    ViewData["Title"] = $"Edit {Model.Film.Title}";
}

<div class="d-flex gap-3 mb-4" style="max-width: 48rem">
    @if (await Posters.UrlAsync(Model.Film.TMDbId, Model.Film.IMDbId, Model.Film.PosterPath, 185) is string posterUrl)
    {
        <img src="@posterUrl" alt="" class="rounded" style="width: 120px; height: auto" />
    }
    <div>
        <h1 class="h4 mb-1">@Model.Film.Title <span class="text-muted fw-normal">@(Model.Film.Year is int year ? $"({year})" : "")</span></h1>
        @if (!string.IsNullOrWhiteSpace(Model.Film.Tagline))
        {
            <p class="fst-italic text-muted mb-1">@Model.Film.Tagline</p>
        }
        <p class="small mb-2">@Model.Film.Overview</p>
    </div>
</div>

<form method="post" class="row g-3" style="max-width: 32rem">
    <div class="col-sm-6">
        <label asp-for="Input.WatchedOn" class="form-label"></label>
        <input asp-for="Input.WatchedOn" class="form-control" />
        <span asp-validation-for="Input.WatchedOn" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="LinkedToFilmId" class="form-label"></label>
        <select asp-for="LinkedToFilmId" asp-items="Model.LinkOptions" class="form-select">
            <option value="">None, ranked on its own</option>
        </select>
        <div class="form-text">For another version of the same film, e.g. a director's cut. It shares that film's score and isn't ranked itself.</div>
    </div>
    <div class="col-12 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-secondary">Save</button>
        <button type="submit" asp-page-handler="Refresh" formnovalidate class="btn btn-outline-secondary">Refresh Data</button>
        <a asp-page="/Films/Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" asp-page-handler="Delete" formnovalidate class="btn btn-outline-danger ms-auto" onclick="return confirm('Delete this film? Its rating stays in Jellyfin.')">Delete</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}