@page "/film/{id:int}/edit"
@model MMDb.Pages.Films.EditModel
@using Microsoft.Extensions.Options
@using MMDb.Options
@inject IOptions<TMDbOptions> TMDbOptions
@{
    ViewData["Title"] = $"Edit {Model.Film.Title}";
}

<p><a asp-page="/Films/Details" asp-route-id="@Model.Id">&larr; Back to Film</a></p>

<div class="d-flex gap-3 align-items-center mb-4">
    @if (Model.Film.PosterPath is not null)
    {
        <img src="@(TMDbOptions.Value.ImageBaseUrl)w92@(Model.Film.PosterPath)" alt="" class="rounded" style="width: 60px; height: auto" />
    }
    <h1 class="h3 mb-0">@Model.Film.Title <span class="text-muted fw-normal">@(Model.Film.Year is int year ? $"({year})" : "")</span></h1>
</div>

<form method="post" class="row g-3" style="max-width: 32rem">
    <div class="col-sm-6">
        <label asp-for="Input.Rating" class="form-label"></label>
        <select asp-for="Input.Rating" asp-items="@(Enumerable.Range(1, 10).Select(x => new SelectListItem(x.ToString(), x.ToString())))" class="form-select"></select>
        <span asp-validation-for="Input.Rating" class="text-danger small"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="Input.WatchedOn" class="form-label"></label>
        <input asp-for="Input.WatchedOn" class="form-control" />
        <span asp-validation-for="Input.WatchedOn" class="text-danger small"></span>
    </div>
    <div class="col-12 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-secondary">Save</button>
        <button type="submit" asp-page-handler="Refresh" formnovalidate class="btn btn-outline-secondary">Refresh Data</button>
        <a asp-page="/Films/Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
        <button type="submit" asp-page-handler="Delete" formnovalidate class="btn btn-outline-danger ms-auto" onclick="return confirm('Delete this film? Its rating stays in Jellyfin.')">Delete</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}