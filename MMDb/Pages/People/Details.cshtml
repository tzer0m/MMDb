@page "/talent/{id:int}"
@model MMDb.Pages.People.DetailsModel
@using Microsoft.Extensions.Options
@using MMDb.Options
@inject IOptions<TMDbOptions> TMDbOptions
@inject IOptions<ExternalLinkOptions> ExternalLinks
@{
    ViewData["Title"] = Model.Person.Name;
    string imageBaseUrl = TMDbOptions.Value.ImageBaseUrl;
}

<div class="detail-layout mb-4">
    <div class="detail-poster">
        <div class="ratio rounded overflow-hidden bg-body-secondary" style="--bs-aspect-ratio: 150%">
            @if (Model.Person.ProfilePath is not null)
            {
                <img src="@(imageBaseUrl)w342@(Model.Person.ProfilePath)" alt="@Model.Person.Name" class="object-fit-cover" />
            }
        </div>
    </div>
    <div class="detail-header d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <div class="d-flex align-items-center gap-3 mb-1">
                <h1 class="mb-0">@Model.Person.Name</h1>
                @if (Model.Person.IMDbId is string imdbId)
                {
                    <a href="@string.Format(ExternalLinks.Value.IMDbPerson, imdbId)" target="_blank" rel="noopener" class="btn btn-outline-secondary d-inline-flex align-items-center" title="IMDb">
                        <img src="/img/imdb.svg" alt="IMDb" height="20" />
                    </a>
                }
            </div>
            <p class="text-muted mb-0">@Model.BirthLine</p>
        </div>
        <div class="d-flex align-items-stretch gap-2">
            @if (Model.AverageMyRating is double averageMyRating)
            {
                <span class="badge fs-2 rating-lg text-black" style="@RatingColour.StyleForRating(averageMyRating)" title="Average My Rating">@averageMyRating.ToString("0.0")</span>
            }
            @if (Model.AverageCommunityRating is double averageCommunityRating)
            {
                <span class="badge fs-2 rating-lg text-black" style="@RatingColour.StyleForRating(averageCommunityRating)" title="Average Community Rating">@averageCommunityRating.ToString("0.0")</span>
            }
            else
            {
                <span class="badge fs-2 rating-lg border border-secondary" style="min-width: 2.5em" title="Average Community Rating"></span>
            }
        </div>
    </div>
    <div class="detail-body">
        @if (!string.IsNullOrWhiteSpace(Model.BiographySummary))
        {
            <p class="d-none d-md-block" style="white-space: pre-line">@Model.BiographySummary</p>
        }
    </div>
</div>

<h2 class="h4 mt-4">Seen In</h2>
<table id="person-films" class="table table-hover align-middle w-100 fs-5 film-table clickable-rows">
    <thead>
        <tr>
            <th class="d-none d-md-table-cell"></th>
            <th class="d-none d-md-table-cell">Title</th>
            <th class="d-none d-md-table-cell">Year</th>
            <th class="d-none d-md-table-cell">Role</th>
            <th class="d-none d-md-table-cell text-center" title="My Rating">MR</th>
            <th class="d-none d-md-table-cell text-center" title="Community Rating">CR</th>
            <th class="d-none d-md-table-cell text-nowrap">Watched</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Film film in Model.Films)
        {
            <tr data-href="@Url.Page("/Films/Details", new { id = film.FilmId })">
                <td class="p-1">
                    @if (film.PosterPath is not null)
                    {
                        <img src="@(imageBaseUrl)w92@(film.PosterPath)" alt="" class="rounded" width="43" height="64" loading="lazy" />
                    }
                </td>
                <td style="max-width: 0; width: 100%">
                    <div class="text-truncate" title="@film.Title">@film.Title</div>
                    <div class="d-flex d-md-none align-items-center gap-2 mt-1">
                        <span class="text-truncate text-muted small" title="@Model.Roles[film.FilmId]">@(film.Year is int year ? $"{year} \u00b7 " : "")@Model.Roles[film.FilmId]</span>
                        <span class="badge text-black ms-auto" style="@RatingColour.StyleForRating(film.Rating)" title="My Rating">@film.Rating</span>
                        @if (film.CommunityRating is double mobileCommunityRating)
                        {
                            <span class="badge text-black" style="@RatingColour.StyleForRating(mobileCommunityRating)" title="Community Rating">@mobileCommunityRating.ToString("0.0")</span>
                        }
                    </div>
                </td>
                <td class="d-none d-md-table-cell">@film.Year</td>
                <td class="d-none d-md-table-cell text-truncate" style="max-width: 16rem" title="@Model.Roles[film.FilmId]">@Model.Roles[film.FilmId]</td>
                <td class="d-none d-md-table-cell text-center"><span class="badge fs-5 text-black" style="@RatingColour.StyleForRating(film.Rating)">@film.Rating</span></td>
                <td class="d-none d-md-table-cell text-center">
                    @if (film.CommunityRating is double communityRating)
                    {
                        <span class="badge fs-5 text-black" style="@RatingColour.StyleForRating(communityRating)">@communityRating.ToString("0.0")</span>
                    }
                </td>
                <td class="d-none d-md-table-cell text-nowrap">@film.WatchedOn?.ToString("d MMM yyyy")</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TopRated.Count > 0)
{
    <h2 class="h4 mt-4">Other Roles</h2>
    <table class="table table-hover align-middle w-100 fs-5 film-table clickable-rows">
        <thead>
            <tr>
                <th class="d-none d-md-table-cell"></th>
                <th class="d-none d-md-table-cell">Title</th>
                <th class="d-none d-md-table-cell">Year</th>
                <th class="d-none d-md-table-cell">Role</th>
                <th class="d-none d-md-table-cell text-center" title="Community Rating">CR</th>
            </tr>
        </thead>
        <tbody>
            @foreach (TopRatedFilm film in Model.TopRated)
            {
                string href = film.FilmId is int filmId ? Url.Page("/Films/Details", new { id = filmId })! : Url.Page("/Films/Preview", new { tmdbId = film.TMDbId })!;
                <tr data-href="@href" class="@(film.FilmId is null ? "" : "seen-film")" title="@(film.FilmId is null ? "" : "Seen")">
                    <td class="p-1">
                        @if (film.PosterPath is not null)
                        {
                            <img src="@(imageBaseUrl)w92@(film.PosterPath)" alt="" class="rounded" width="43" height="64" loading="lazy" />
                        }
                    </td>
                    <td style="max-width: 0; width: 100%">
                        <div class="text-truncate" title="@film.Title">@film.Title</div>
                        <div class="d-flex d-md-none align-items-center gap-2 mt-1">
                            <span class="text-truncate text-muted small" title="@film.Role">@(film.Year is int year ? $"{year} \u00b7 " : "")@film.Role</span>
                            @if (film.CommunityRating is double mobileRating)
                            {
                                <span class="badge text-black ms-auto" style="@RatingColour.StyleForRating(mobileRating)" title="@film.RatingSources">@mobileRating.ToString("0.0")</span>
                            }
                        </div>
                    </td>
                    <td class="d-none d-md-table-cell">@film.Year</td>
                    <td class="d-none d-md-table-cell text-truncate" style="max-width: 16rem" title="@film.Role">@film.Role</td>
                    <td class="d-none d-md-table-cell text-center">
                        @if (film.CommunityRating is double rating)
                        {
                            <span class="badge fs-5 text-black" style="@RatingColour.StyleForRating(rating)" title="@film.RatingSources">@rating.ToString("0.0")</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Styles {
    <style>
        .clickable-rows tbody tr[data-href] { cursor: pointer; }
    </style>
}

@section Scripts {
    <script>
        document.querySelectorAll('.clickable-rows tbody').forEach(body => body.addEventListener('click', event => {
            const row = event.target.closest('tr[data-href]');
            if (!row) {
                return;
            }
            if (event.ctrlKey || event.metaKey) {
                window.open(row.dataset.href, '_blank');
            }
            else {
                window.location.href = row.dataset.href;
            }
        }));
    </script>
}
