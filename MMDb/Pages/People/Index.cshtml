@page "/talent"
@model MMDb.Pages.People.IndexModel
@using Microsoft.Extensions.Options
@using MMDb.Options
@inject IOptions<TMDbOptions> TMDbOptions
@{
    ViewData["Title"] = "Talent";
    string imageBaseUrl = TMDbOptions.Value.ImageBaseUrl;
}

<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <form id="talent-search" class="input-group flex-grow-1 w-auto">
        <input type="search" id="talent-search-input" class="form-control" placeholder="Search Talent" aria-label="Search Talent" />
        <select id="talent-role" class="form-select flex-grow-0 w-auto" aria-label="Filter by Role">
            <option value="">All</option>
            <option value="D">Directors</option>
            <option value="A">Actors</option>
        </select>
        <select id="talent-min-films" class="form-select flex-grow-0 w-auto" aria-label="Minimum Films">
            <option value="1">Any Films</option>
            <option value="2">2+ Films</option>
            <option value="3">3+ Films</option>
            <option value="5">5+ Films</option>
            <option value="10">10+ Films</option>
        </select>
        <button type="submit" class="btn btn-outline-secondary d-flex align-items-center" title="Search" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" /></svg>
        </button>
    </form>
    <div id="talent-paging"></div>
</div>

<table id="talent" class="table table-hover align-middle w-100 fs-5 film-table">
    <thead>
        <tr>
            <th class="d-none d-md-table-cell"></th>
            <th class="d-none d-md-table-cell">Name</th>
            <th class="d-none d-md-table-cell text-center">Films</th>
            <th class="d-none d-md-table-cell text-center" title="D: director, A: actor">Role</th>
            <th class="d-none d-md-table-cell text-center" title="Average My Rating">MR</th>
            <th class="d-none d-md-table-cell text-center" title="Average Community Rating">CR</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.css" />
    <style>
        #talent-paging ul.pagination { margin: 0; }
    </style>
}

@section Scripts {
    <script src="~/lib/datatables.net/dataTables.min.js"></script>
    <script src="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.js"></script>
    <script>
        const imageBaseUrl = '@(imageBaseUrl)w92';
        const personUrl = '@Url.Content("~/talent/")';
        const searchInput = document.getElementById('talent-search-input');
        const roleFilter = document.getElementById('talent-role');
        const minFilms = document.getElementById('talent-min-films');
        const escapeHtml = text => String(text).replace(/[&<>"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
        const ratingBadge = (rating, colour, classes, title) => rating == null ? '' : `<span class="badge ${classes} text-black" style="background-color: ${colour}"${title ? ` title="${title}"` : ''}>${rating.toFixed(1)}</span>`;
        // The server searches, filters, sorts and pages, so only one page of rows is ever loaded.
        const talent = new DataTable('#talent', {
            serverSide: true,
            ajax: { url: '@Url.Page("/People/Index", "Data")', data: request => { request.role = roleFilter.value; request.minFilms = minFilms.value; } },
            search: { search: searchInput.value },
            order: [[2, 'desc'], [1, 'asc']],
            autoWidth: false,
            pageLength: 100,
            createdRow: row => row.classList.add('position-relative'),
            columns: [
                { data: 'profilePath', orderable: false, createdCell: cell => cell.classList.add('p-1'), render: path => path ? `<img src="${imageBaseUrl}${escapeHtml(path)}" alt="" class="rounded object-fit-cover" width="43" height="64" loading="lazy" />` : '' },
                { data: 'name', createdCell: cell => cell.style.cssText = 'max-width: 0; width: 100%', render: (name, type, person) => `<div class="text-truncate" title="${escapeHtml(name)}"><a href="${personUrl}${person.personId}" class="stretched-link text-reset text-decoration-none">${escapeHtml(name)}</a></div><div class="d-flex d-md-none align-items-center gap-2 mt-1"><span class="text-truncate text-muted small">${person.filmCount} ${person.filmCount === 1 ? 'film' : 'films'} &middot; ${person.roles}</span>${ratingBadge(person.averageMyRating, person.myRatingColour, 'ms-auto', 'Average My Rating')}${ratingBadge(person.averageCommunityRating, person.communityRatingColour, '', 'Average Community Rating')}</div>` },
                { data: 'filmCount', className: 'd-none d-md-table-cell text-center' },
                { data: 'roles', className: 'd-none d-md-table-cell text-center text-nowrap' },
                { data: 'averageMyRating', className: 'd-none d-md-table-cell text-center', render: (rating, type, person) => ratingBadge(rating, person.myRatingColour, 'fs-5') },
                { data: 'averageCommunityRating', className: 'd-none d-md-table-cell text-center', render: (rating, type, person) => ratingBadge(rating, person.communityRatingColour, 'fs-5') }
            ],
            language: { emptyTable: 'No talent yet.', zeroRecords: 'No matching talent.', info: '_START_ to _END_ of _TOTAL_', infoEmpty: '0 to 0 of 0', infoFiltered: '(_MAX_)' },
            layout: { topStart: null, topEnd: null, bottomStart: 'info', bottomEnd: 'paging' }
        });
        document.getElementById('talent-paging').append(document.querySelector('#talent_wrapper .dt-paging'));
        // Re-query with the current control values; typing waits briefly so each keystroke doesn't hit the server.
        const applyFilters = () => talent.search(searchInput.value).draw();
        let searchTimer;
        searchInput.addEventListener('input', () => {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(applyFilters, 300);
        });
        roleFilter.addEventListener('change', applyFilters);
        minFilms.addEventListener('change', applyFilters);
        document.getElementById('talent-search').addEventListener('submit', event => {
            event.preventDefault();
            clearTimeout(searchTimer);
            applyFilters();
        });
        window.addEventListener('pageshow', event => {
            if (event.persisted) {
                applyFilters();
            }
        });
    </script>
}