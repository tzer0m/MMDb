@page "/talent"
@model MMDb.Pages.People.IndexModel
@using System.Globalization
@using Microsoft.Extensions.Options
@using MMDb.Options
@inject IOptions<TMDbOptions> TMDbOptions
@{
    ViewData["Title"] = "Talent";
    string imageBaseUrl = TMDbOptions.Value.ImageBaseUrl;
}

<form id="talent-filters" autocomplete="off">
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <div class="input-group flex-grow-1 w-auto">
            <input type="search" name="name" value="@Model.Filter.Name" class="form-control" placeholder="Search Talent" aria-label="Search Talent" />
            <button type="button" id="talent-filter-toggle" class="btn btn-outline-secondary d-flex align-items-center gap-2" data-bs-toggle="collapse" data-bs-target="#talent-filter-panel" aria-controls="talent-filter-panel" aria-expanded="false">
                Filters <span id="talent-filter-count" class="badge text-bg-secondary"></span>
            </button>
        </div>
        <div id="talent-paging"></div>
    </div>
    <div id="talent-filter-panel" class="collapse">
        <div class="row g-2 mb-3">
            <div class="col-6 col-md-4 col-xl-3">
                <label for="filter-film" class="form-label small mb-1">Film Title</label>
                <input type="search" id="filter-film" name="film" value="@Model.Filter.Film" class="form-control" placeholder="Appeared in" />
            </div>
            <div class="col-6 col-md-4 col-xl-3">
                <label for="filter-role" class="form-label small mb-1">Role</label>
                <select id="filter-role" name="role" class="form-select">
                    <option value="">Any</option>
                    <option value="D" selected="@(Model.Filter.Role == "D")">Director</option>
                    <option value="A" selected="@(Model.Filter.Role == "A")">Actor</option>
                </select>
            </div>
            @{ RangeFilter("Films", "Films", Model.Filter.MinFilms, Model.Filter.MaxFilms, "1", "0"); }
            @{ RangeFilter("My Rating", "Mr", Model.Filter.MinMr, Model.Filter.MaxMr, "0.1", "1"); }
            @{ RangeFilter("Community Rating", "Cr", Model.Filter.MinCr, Model.Filter.MaxCr, "0.1", "0"); }
            @{ RangeFilter("Delta", "Delta", Model.Filter.MinDelta, Model.Filter.MaxDelta, "0.1", null); }
            @{ RangeFilter($"Leads (Top {Model.LeadCount})", "Leads", Model.Filter.MinLeads, Model.Filter.MaxLeads, "1", "0"); }
            @{ RangeFilter("Film Year", "Year", Model.Filter.MinYear, Model.Filter.MaxYear, "1", null); }
            <div class="col-12 d-flex justify-content-end">
                <button type="button" id="talent-filter-clear" class="btn btn-sm btn-outline-secondary">Clear Filters</button>
            </div>
        </div>
    </div>
</form>

<table id="talent" class="table table-hover align-middle w-100 fs-5 film-table">
    <thead>
        <tr>
            <th class="d-none d-md-table-cell"></th>
            <th class="d-none d-md-table-cell">Name</th>
            <th class="d-none d-md-table-cell text-center">Films</th>
            <th class="d-none d-md-table-cell text-center" title="D: director, A: actor">Role</th>
            <th class="d-none d-md-table-cell text-center" title="Films billed in the top @Model.LeadCount">Leads</th>
            <th class="d-none d-md-table-cell text-center" title="Average My Rating">MR</th>
            <th class="d-none d-md-table-cell text-center" title="Average Community Rating">CR</th>
            <th class="d-none d-md-table-cell text-center" title="Average My Rating minus Community Rating">&Delta;</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@{
    void RangeFilter(string label, string name, double? min, double? max, string step, string? lowest)
    {
        <div class="col-6 col-md-4 col-xl-3">
            <label for="filter-min-@name" class="form-label small mb-1">@label</label>
            <div class="input-group">
                <input type="number" id="filter-min-@name" name="min@(name)" value="@min?.ToString(CultureInfo.InvariantCulture)" step="@step" min="@lowest" class="form-control" placeholder="Min" aria-label="Minimum @label" />
                <input type="number" name="max@(name)" value="@max?.ToString(CultureInfo.InvariantCulture)" step="@step" min="@lowest" class="form-control" placeholder="Max" aria-label="Maximum @label" />
            </div>
        </div>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.css" />
    <style>
        #talent-paging ul.pagination { margin: 0; }
    </style>
}

@section Scripts {
    <script src="~/lib/datatables.net/dataTables.min.js"></script>
    <script src="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/filter-table.js" asp-append-version="true"></script>
    <script>
        const imageBaseUrl = '@(imageBaseUrl)w92';
        const personUrl = '@Url.Content("~/talent/")';
        createFilterTable('talent', {
            ajax: '@Url.Page("/People/Index", "Data")',
            order: [[2, 'desc'], [1, 'asc']],
            columns: [
                { data: 'profilePath', orderable: false, createdCell: cell => cell.classList.add('p-1'), render: path => path ? `<img src="${imageBaseUrl}${escapeHtml(path)}" alt="" class="rounded object-fit-cover" width="43" height="64" loading="lazy" />` : '<div class="photo-placeholder"></div>' },
                { data: 'name', createdCell: cell => cell.style.cssText = 'max-width: 0; width: 100%', render: (name, type, person) => `<div class="text-truncate" title="${escapeHtml(name)}"><a href="${personUrl}${person.personId}" class="stretched-link text-reset text-decoration-none">${escapeHtml(name)}</a></div><div class="d-flex d-md-none align-items-center gap-2 mt-1"><span class="text-truncate text-muted small">${person.filmCount} ${person.filmCount === 1 ? 'film' : 'films'} &middot; ${person.roles}</span>${ratingBadge(person.averageMyRating, person.myRatingColour, 'ms-auto', 'Average My Rating')}${ratingBadge(person.averageCommunityRating, person.communityRatingColour, '', 'Average Community Rating')}</div>` },
                { data: 'filmCount', className: 'd-none d-md-table-cell text-center' },
                { data: 'roles', className: 'd-none d-md-table-cell text-center text-nowrap' },
                { data: 'leads', className: 'd-none d-md-table-cell text-center' },
                { data: 'averageMyRating', className: 'd-none d-md-table-cell text-center', render: (rating, type, person) => ratingBadge(rating, person.myRatingColour, 'fs-5') },
                { data: 'averageCommunityRating', className: 'd-none d-md-table-cell text-center', render: (rating, type, person) => ratingBadge(rating, person.communityRatingColour, 'fs-5') },
                { data: 'delta', className: 'd-none d-md-table-cell text-center text-nowrap', render: formatDelta }
            ],
            language: { emptyTable: 'No talent yet.', zeroRecords: 'No matching talent.', info: '_START_ to _END_ of _TOTAL_', infoEmpty: '0 to 0 of 0', infoFiltered: '(_MAX_)' }
        });
    </script>
}