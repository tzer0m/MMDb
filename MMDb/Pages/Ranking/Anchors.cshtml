@page "/rank/anchors"
@model MMDb.Pages.Ranking.AnchorsModel
@{
    ViewData["Title"] = "Anchors";
}

<h1 class="h4">Anchors</h1>
<p class="text-muted">Pick 3 to 5 films you remember well in each band. They're ranked against each other first, then every other film is placed against them.</p>

<form method="post">
    <div class="accordion mb-3">
        @foreach (IGrouping<int, FilmScore> band in Model.Bands)
        {
            int anchors = band.Count(x => x.IsAnchor);
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button type="button" class="accordion-button collapsed gap-2" data-bs-toggle="collapse" data-bs-target="#band-@band.Key" aria-expanded="false" aria-controls="band-@band.Key">
                        Rated @band.Key
                        <span class="badge @(anchors is >= 3 and <= 5 ? "text-bg-success" : "text-bg-secondary")" data-band-count="@band.Key">@anchors</span>
                        <span class="text-muted small">@band.Count() films</span>
                    </button>
                </h2>
                <div id="band-@band.Key" class="accordion-collapse collapse">
                    <div class="accordion-body">
                        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-1">
                            @foreach (FilmScore score in band)
                            {
                                <div class="col">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" name="anchorIds" value="@score.FilmId" id="anchor-@score.FilmId" data-band="@band.Key" checked="@score.IsAnchor" />
                                        <label class="form-check-label" for="anchor-@score.FilmId">
                                            @score.Film.Title <span class="text-muted">@(score.Film.Year is int year ? $"({year})" : "")</span>
                                            @if (score.IsSettled)
                                            {
                                                <span class="badge text-bg-secondary">@score.ShownScore</span>
                                            }
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="position-sticky bottom-0 bg-body py-3 d-flex gap-2">
        <button type="submit" class="btn btn-secondary">Save Anchors</button>
        <a asp-page="/Ranking/Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        // Keep each band's anchor count up to date, green when it has 3 to 5.
        document.querySelectorAll('input[name=anchorIds]').forEach(checkbox => checkbox.addEventListener('change', () => {
            const band = checkbox.dataset.band;
            const count = document.querySelectorAll(`input[name=anchorIds][data-band="${band}"]:checked`).length;
            const badge = document.querySelector(`[data-band-count="${band}"]`);
            badge.textContent = count;
            badge.classList.toggle('text-bg-success', count >= 3 && count <= 5);
            badge.classList.toggle('text-bg-secondary', count < 3 || count > 5);
        }));
    </script>
}