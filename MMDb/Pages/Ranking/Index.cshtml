@page "/rank/{filmId:int?}"
@model MMDb.Pages.Ranking.IndexModel
@{
    ViewData["Title"] = "Ranking";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Ranking</h1>
    <span class="text-muted small">@Model.Settled of @Model.Total settled</span>
</div>

@foreach (string message in Model.Messages)
{
    <div class="alert alert-secondary py-2">@message</div>
}

@if (Model.Question is RankingQuestion question && question.Opponent is Film opponent)
{
    <div class="d-flex justify-content-end text-muted small mb-2">
        <span>@question.Comparisons of @question.ComparisonsNeeded answers</span>
    </div>
    <p class="fs-5 text-center mb-3">Which is better?</p>
    <form method="post" asp-page-handler="Answer" id="rank-answer">
        <input type="hidden" name="filmId" value="@question.Film.FilmId" />
        <input type="hidden" name="otherFilmId" value="@opponent.FilmId" />
        <input type="hidden" name="back" value="@(Model.Back ? "true" : "false")" />
        <div class="row g-3 text-center mb-3">
            @{ await FilmChoice(question.Film, "Better", "rank-left", "\u2190"); }
            @{ await FilmChoice(opponent, "Worse", "rank-right", "\u2192"); }
        </div>
    </form>
    <div class="rank-actions position-sticky bottom-0 bg-body border-top pt-2 pb-3">
        <button type="submit" form="rank-answer" id="rank-similar" name="result" value="Similar" class="btn btn-secondary btn-lg w-100 py-md-3 mb-2">About the Same <span class="small opacity-75 d-none d-md-inline">&darr;</span></button>
        <div class="d-flex gap-2">
            <button type="submit" form="rank-answer" id="rank-skip" name="result" value="Skipped" class="btn btn-outline-secondary flex-fill text-truncate" title="Don't Remember @opponent.Title">Don't Remember<span class="d-none d-md-inline"> @opponent.Title <span class="small opacity-75">&uarr;</span></span></button>
            <form method="post" asp-page-handler="Undo" class="d-flex">
                <input type="hidden" name="back" value="@(Model.Back ? "true" : "false")" />
                <button type="submit" id="rank-undo" class="btn btn-outline-secondary">Undo<span class="small opacity-75 d-none d-md-inline"> Backspace</span></button>
            </form>
            <a asp-page="/Films/Details" asp-route-id="@question.Film.FilmId" class="btn btn-outline-secondary text-nowrap">Finish Later</a>
        </div>
    </div>
}
else if (Model.Settled == 0)
{
    <div class="text-center py-5">
        <p class="fs-5">Nothing is settled yet, so there's nothing to compare films with.</p>
    </div>
}
else if (Model.Settled == Model.Total)
{
    <div class="text-center py-5">
        <p class="fs-5">Every film is settled.</p>
    </div>
}
else
{
    <div class="text-center py-5">
        <a asp-page="/Ranking/Index" class="btn btn-secondary btn-lg">Next Film</a>
    </div>
}

@{
    async Task FilmChoice(Film film, string result, string id, string key)
    {
        <div class="col-6">
            <button type="submit" id="@id" name="result" value="@result" class="btn btn-outline-secondary w-100 h-100 p-2 p-md-3 d-flex flex-column justify-content-start" title="@film.Title is better (@key)">
                <span class="d-block mx-auto rank-poster">
                    <span class="d-block ratio rounded overflow-hidden bg-body-secondary mb-2" style="--bs-aspect-ratio: 150%">
                        @if (await Posters.UrlAsync(film.TMDbId, film.IMDbId, film.PosterPath, 342) is string posterUrl)
                        {
                            <img src="@posterUrl" alt="@film.Title poster" class="object-fit-cover" />
                        }
                    </span>
                </span>
                <span class="fw-semibold text-body rank-title">@film.Title</span>
                <span class="d-block text-muted small">@film.Year <span class="opacity-75">@key</span></span>
                <span class="text-muted small text-start mt-2 rank-synopsis">@film.Overview</span>
            </button>
        </div>
    }
}

@section Styles {
    <style>
        /* A fixed width, so a short title doesn't shrink the poster. */
        .rank-poster {
            width: 100%;
            max-width: 220px;
        }

        /* Titles and synopses always take the same space, clamped and padded to 2 and 5 lines, so the posters, text and buttons stay in place from one question to the next. Clamping needs -webkit-box, so these spans mustn't also have d-block. */
        .rank-title,
        .rank-synopsis {
            display: -webkit-box;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .rank-title {
            -webkit-line-clamp: 2;
            line-clamp: 2;
            min-height: 3em;
        }

        .rank-synopsis {
            -webkit-line-clamp: 5;
            line-clamp: 5;
            min-height: 7.5em;
        }

        /* On phones, smaller posters keep more of both films in view above the answer buttons, which stay pinned to the bottom. */
        @@media (max-width: 767.98px) {
            .rank-poster {
                max-width: 130px;
            }
        }
    </style>
}

@section Scripts {
    <script>
        // Arrow keys answer: left or right picks that film, down is about the same, up is don't remember, and backspace undoes.
        const keyButtons = { ArrowLeft: 'rank-left', ArrowRight: 'rank-right', ArrowDown: 'rank-similar', ArrowUp: 'rank-skip', Backspace: 'rank-undo' };
        // Held keys and presses carried over from the last question are ignored, so one press only ever gives one answer.
        const readyAt = performance.now() + 500;
        let answered = false;
        document.addEventListener('keydown', event => {
            const button = document.getElementById(keyButtons[event.key]);
            if (!button || answered || event.repeat || performance.now() < readyAt || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || event.target.closest('input, textarea, select')) {
                return;
            }
            event.preventDefault();
            answered = true;
            button.click();
        });
        // Allow answering again if the browser brings the page back from its cache.
        window.addEventListener('pageshow', () => answered = false);
    </script>
}