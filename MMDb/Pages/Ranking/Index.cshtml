@page "/rank/{filmId:int?}"
@model MMDb.Pages.Ranking.IndexModel
@{
    ViewData["Title"] = "Ranking";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Ranking</h1>
    <div class="d-flex align-items-center gap-3">
        <span class="text-muted small">@Model.Settled of @Model.Total settled</span>
        <a asp-page="/Ranking/Anchors" class="btn btn-sm btn-outline-secondary">Anchors</a>
    </div>
</div>

@foreach (string message in Model.Messages)
{
    <div class="alert alert-secondary py-2">@message</div>
}

@if (Model.Question is RankingQuestion question && question.Opponent is Film opponent)
{
    <div class="d-flex justify-content-end text-muted small mb-2">
        <span>
            @if (question.IsAnchor)
            {
                <text>Anchor &middot; </text>
            }
            @question.Comparisons of @question.ComparisonsNeeded answers
        </span>
    </div>
    <p class="fs-5 text-center mb-3">Which is better?</p>
    <form method="post" asp-page-handler="Answer" id="rank-answer">
        <input type="hidden" name="filmId" value="@question.Film.FilmId" />
        <input type="hidden" name="otherFilmId" value="@opponent.FilmId" />
        <div class="row g-3 text-center mb-3">
            @{ await FilmChoice(question.Film, "Better", "rank-left", "\u2190"); }
            @{ await FilmChoice(opponent, "Worse", "rank-right", "\u2192"); }
        </div>
        <div class="d-flex gap-2">
            <button type="submit" id="rank-similar" name="result" value="Similar" class="btn btn-secondary btn-lg flex-fill py-3">About the Same <span class="small opacity-75">&darr;</span></button>
        </div>
        <button type="submit" id="rank-skip" name="result" value="Skipped" class="btn btn-outline-secondary w-100 mt-2">Don't Remember @opponent.Title <span class="small opacity-75">&uarr;</span></button>
    </form>
    <div class="d-flex gap-2 mt-3">
        <form method="post" asp-page-handler="Undo" class="flex-fill">
            <button type="submit" id="rank-undo" class="btn btn-outline-secondary w-100">Undo <span class="small opacity-75">Backspace</span></button>
        </form>
        <a asp-page="/Films/Details" asp-route-id="@question.Film.FilmId" class="btn btn-outline-secondary flex-fill">Finish Later</a>
    </div>
}
else if (Model.Settled == 0)
{
    <div class="text-center py-5">
        <p class="fs-5">Nothing is settled yet, so there's nothing to compare films with.</p>
        <a asp-page="/Ranking/Anchors" class="btn btn-secondary btn-lg">Pick Anchors</a>
    </div>
}
else if (Model.Settled == Model.Total)
{
    <div class="text-center py-5">
        <p class="fs-5">Every film is settled.</p>
    </div>
}
else
{
    <div class="text-center py-5">
        <a asp-page="/Ranking/Index" class="btn btn-secondary btn-lg">Next Film</a>
    </div>
}

@{
    async Task FilmChoice(Film film, string result, string id, string key)
    {
        <div class="col-6">
            <button type="submit" id="@id" name="result" value="@result" class="btn btn-outline-secondary w-100 h-100 p-2 p-md-3" title="@film.Title is better (@key)">
                <span class="d-block mx-auto" style="max-width: 220px">
                    <span class="d-block ratio rounded overflow-hidden bg-body-secondary mb-2" style="--bs-aspect-ratio: 150%">
                        @if (await Posters.UrlAsync(film.TMDbId, film.IMDbId, film.PosterPath, 342) is string posterUrl)
                        {
                            <img src="@posterUrl" alt="@film.Title poster" class="object-fit-cover" />
                        }
                    </span>
                    <span class="d-block fw-semibold text-body">@film.Title</span>
                    <span class="d-block text-muted small">@film.Year <span class="opacity-75">@key</span></span>
                </span>
            </button>
        </div>
    }
}

@section Scripts {
    <script>
        // Arrow keys answer: left or right picks that film, down is about the same, up is don't remember, and backspace undoes.
        const keyButtons = { ArrowLeft: 'rank-left', ArrowRight: 'rank-right', ArrowDown: 'rank-similar', ArrowUp: 'rank-skip', Backspace: 'rank-undo' };
        let answered = false;
        document.addEventListener('keydown', event => {
            const button = document.getElementById(keyButtons[event.key]);
            if (!button || answered || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || event.target.closest('input, textarea, select')) {
                return;
            }
            event.preventDefault();
            answered = true;
            button.click();
        });
        // Allow answering again if the browser brings the page back from its cache.
        window.addEventListener('pageshow', () => answered = false);
    </script>
}